# ── LLM — FREE TIER (active) ──────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM — PAID TIER (add key + update agent/llm.py) ───────
# ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# ── Supabase ───────────────────────────────────────────────
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# ── Redis (Upstash) ────────────────────────────────────────
# Get from: https://upstash.com → free Redis database
UPSTASH_REDIS_URL=redis://default:your_token@your-endpoint.upstash.io:6379

# ── External APIs ──────────────────────────────────────────
# Yelp: https://fusion.yelp.com → Create App → get API key
YELP_API_KEY=your_yelp_api_key_here

# ── App ────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
DEFAULT_CITY=Toronto, ON
